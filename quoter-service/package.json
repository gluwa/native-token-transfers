{
  "name": "@wormhole-foundation/ntt-quoter-service",
  "version": "1.0.0",
  "description": "Off-chain quoter service that signs SpecialRelayer execution quotes.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ntt-quoter-service": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "start": "node ./dist/index.js",
    "dev": "tsx ./src/index.ts",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config ./jest.config.ts",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "prettier": "prettier --write ./src ./__tests__"
  },
  "dependencies": {
    "ethers": "^6.5.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.2",
    "typescript": "^5.1.1"
  }
}
